{
  "openapi": "3.1.0",
  "info": {
    "title": "RangeOps API",
    "version": "0.1.0",
    "description": "Bookings, payments, bucket codes, passes, robot hires and the fleet for RangeOps ranges. Runs locally only for now. See docs/PLAN.md and .scratch/backend-api/spec.md."
  },
  "servers": [
    {
      "url": "http://localhost:8787",
      "description": "Local dev server"
    }
  ],
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "A session token from POST /auth/verify."
      }
    },
    "schemas": {
      "Health": {
        "type": "object",
        "properties": {
          "ok": {
            "type": "boolean",
            "enum": [
              true
            ]
          },
          "time": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "ok",
          "time"
        ]
      },
      "RangeSummary": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "slug": {
            "type": "string",
            "example": "demo"
          },
          "name": {
            "type": "string"
          },
          "timeZone": {
            "type": "string",
            "example": "Australia/Sydney"
          },
          "currency": {
            "type": "string",
            "example": "AUD"
          }
        },
        "required": [
          "id",
          "slug",
          "name",
          "timeZone",
          "currency"
        ]
      },
      "Range": {
        "allOf": [
          {
            "$ref": "#/components/schemas/RangeSummary"
          },
          {
            "type": "object",
            "properties": {
              "prices": {
                "type": "object",
                "properties": {
                  "offPeakCentsPerHour": {
                    "type": "integer",
                    "description": "Money in cents of the range currency",
                    "example": 1800
                  },
                  "peakCentsPerHour": {
                    "type": "integer",
                    "description": "Money in cents of the range currency",
                    "example": 1800
                  }
                },
                "required": [
                  "offPeakCentsPerHour",
                  "peakCentsPerHour"
                ]
              },
              "openingHours": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/OpeningHours"
                }
              },
              "peakWindows": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/PeakWindow"
                }
              },
              "bays": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/Bay"
                }
              },
              "addOns": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/AddOnPrice"
                }
              },
              "bucketProducts": {
                "type": "array",
                "items": {
                  "$ref": "#/components/schemas/BucketProduct"
                }
              }
            },
            "required": [
              "prices",
              "openingHours",
              "peakWindows",
              "bays",
              "addOns",
              "bucketProducts"
            ]
          }
        ]
      },
      "OpeningHours": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0 Sunday to 6 Saturday"
          },
          "opens": {
            "type": "string",
            "description": "Local time HH:MM, 24-hour; \"24:00\" is midnight at the end of the day",
            "example": "07:00"
          },
          "closes": {
            "type": "string",
            "description": "Local time HH:MM, 24-hour; \"24:00\" is midnight at the end of the day",
            "example": "07:00"
          }
        },
        "required": [
          "weekday",
          "opens",
          "closes"
        ]
      },
      "PeakWindow": {
        "type": "object",
        "properties": {
          "weekday": {
            "type": "integer",
            "minimum": 0,
            "maximum": 6,
            "description": "0 Sunday to 6 Saturday"
          },
          "from": {
            "type": "string",
            "description": "Local time HH:MM, 24-hour; \"24:00\" is midnight at the end of the day",
            "example": "07:00"
          },
          "to": {
            "type": "string",
            "description": "Local time HH:MM, 24-hour; \"24:00\" is midnight at the end of the day",
            "example": "07:00"
          }
        },
        "required": [
          "weekday",
          "from",
          "to"
        ],
        "description": "Bay-hours starting inside a window cost the peak price"
      },
      "Bay": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "rangeId": {
            "type": "string",
            "format": "uuid"
          },
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 255
          },
          "name": {
            "type": "string"
          },
          "active": {
            "type": "boolean"
          },
          "offPeakCentsPerHour": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Overrides the range's off-peak price when set",
            "example": 1800
          },
          "peakCentsPerHour": {
            "type": [
              "integer",
              "null"
            ],
            "description": "Overrides the range's peak price when set",
            "example": 1800
          }
        },
        "required": [
          "id",
          "rangeId",
          "number",
          "name",
          "active",
          "offPeakCentsPerHour",
          "peakCentsPerHour"
        ]
      },
      "AddOnPrice": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AddOnKind"
          },
          "priceCents": {
            "type": "integer",
            "description": "Money in cents of the range currency",
            "example": 1800
          },
          "unit": {
            "type": "string",
            "enum": [
              "per_hour",
              "per_booking"
            ]
          }
        },
        "required": [
          "kind",
          "priceCents",
          "unit"
        ]
      },
      "AddOnKind": {
        "type": "string",
        "enum": [
          "robot",
          "club_hire",
          "lesson"
        ]
      },
      "BucketProduct": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "name": {
            "type": "string"
          },
          "balls": {
            "type": "integer"
          },
          "priceCents": {
            "type": "integer",
            "description": "Money in cents of the range currency",
            "example": 1800
          },
          "active": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name",
          "balls",
          "priceCents",
          "active"
        ]
      },
      "Error": {
        "type": "object",
        "properties": {
          "error": {
            "type": "object",
            "properties": {
              "code": {
                "type": "string",
                "example": "not_found"
              },
              "message": {
                "type": "string"
              }
            },
            "required": [
              "code",
              "message"
            ]
          }
        },
        "required": [
          "error"
        ]
      },
      "Availability": {
        "type": "object",
        "properties": {
          "rangeId": {
            "type": "string",
            "format": "uuid"
          },
          "date": {
            "type": "string",
            "example": "2026-11-24"
          },
          "timeZone": {
            "type": "string"
          },
          "hours": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "startsAt": {
                  "type": "string",
                  "format": "date-time",
                  "example": "2026-11-24T05:00:00.000Z"
                },
                "localTime": {
                  "type": "string",
                  "description": "Local time HH:MM, 24-hour; \"24:00\" is midnight at the end of the day",
                  "example": "07:00"
                },
                "robotsFree": {
                  "type": "integer"
                }
              },
              "required": [
                "startsAt",
                "localTime",
                "robotsFree"
              ]
            },
            "description": "Each open hour of the day, with how many robots could be hired for it"
          },
          "bays": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "bayId": {
                  "type": "string",
                  "format": "uuid"
                },
                "number": {
                  "type": "integer"
                },
                "name": {
                  "type": "string"
                },
                "slots": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Slot"
                  }
                }
              },
              "required": [
                "bayId",
                "number",
                "name",
                "slots"
              ]
            }
          }
        },
        "required": [
          "rangeId",
          "date",
          "timeZone",
          "hours",
          "bays"
        ]
      },
      "Slot": {
        "type": "object",
        "properties": {
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "localTime": {
            "type": "string",
            "description": "Local time HH:MM, 24-hour; \"24:00\" is midnight at the end of the day",
            "example": "07:00"
          },
          "peak": {
            "type": "boolean"
          },
          "priceCents": {
            "type": "integer",
            "description": "Money in cents of the range currency",
            "example": 1800
          },
          "free": {
            "type": "boolean"
          }
        },
        "required": [
          "startsAt",
          "endsAt",
          "localTime",
          "peak",
          "priceCents",
          "free"
        ]
      },
      "Session": {
        "type": "object",
        "properties": {
          "sessionToken": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "$ref": "#/components/schemas/Account"
          }
        },
        "required": [
          "sessionToken",
          "expiresAt",
          "account"
        ]
      },
      "Account": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "email": {
            "type": "string",
            "format": "email"
          },
          "name": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "email",
          "name",
          "createdAt"
        ]
      },
      "Me": {
        "type": "object",
        "properties": {
          "account": {
            "$ref": "#/components/schemas/Account"
          },
          "staffAt": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/RangeSummary"
            },
            "description": "Ranges this account can run from the console"
          }
        },
        "required": [
          "account",
          "staffAt"
        ]
      },
      "Booking": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "range": {
            "$ref": "#/components/schemas/RangeSummary"
          },
          "bay": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "number": {
                "type": "integer"
              },
              "name": {
                "type": "string"
              }
            },
            "required": [
              "id",
              "number",
              "name"
            ]
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "source": {
            "type": "string",
            "enum": [
              "rangeops",
              "external"
            ],
            "description": "rangeops: booked in the app. external: handed in from another booking system."
          },
          "externalRef": {
            "type": [
              "string",
              "null"
            ]
          },
          "customerName": {
            "type": [
              "string",
              "null"
            ]
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "endsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "hours": {
            "type": "integer"
          },
          "status": {
            "type": "string",
            "enum": [
              "pending_payment",
              "confirmed",
              "cancelled"
            ]
          },
          "checkedInAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "addOns": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "kind": {
                  "$ref": "#/components/schemas/AddOnKind"
                },
                "quantity": {
                  "type": "integer"
                },
                "priceCents": {
                  "type": "integer",
                  "description": "Money in cents of the range currency",
                  "example": 1800
                }
              },
              "required": [
                "kind",
                "quantity",
                "priceCents"
              ]
            }
          },
          "totalCents": {
            "type": "integer",
            "description": "Money in cents of the range currency",
            "example": 1800
          },
          "currency": {
            "type": "string"
          },
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "cancelledAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          }
        },
        "required": [
          "id",
          "range",
          "bay",
          "accountId",
          "source",
          "externalRef",
          "customerName",
          "startsAt",
          "endsAt",
          "hours",
          "status",
          "checkedInAt",
          "addOns",
          "totalCents",
          "currency",
          "order",
          "createdAt",
          "cancelledAt"
        ]
      },
      "Order": {
        "type": [
          "object",
          "null"
        ],
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "accountId": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "rangeId": {
            "type": "string",
            "format": "uuid"
          },
          "kind": {
            "type": "string",
            "enum": [
              "booking",
              "bucket",
              "pass",
              "ball_credit"
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "pending",
              "paid",
              "failed",
              "refunded"
            ]
          },
          "totalCents": {
            "type": "integer"
          },
          "currency": {
            "type": "string"
          },
          "lines": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "description": {
                  "type": "string"
                },
                "quantity": {
                  "type": "integer"
                },
                "unitCents": {
                  "type": "integer"
                }
              },
              "required": [
                "description",
                "quantity",
                "unitCents"
              ]
            }
          },
          "paymentProvider": {
            "type": [
              "string",
              "null"
            ],
            "description": "\"fake\" today; \"none\" when nothing was charged; \"ball_credit\"; \"external\""
          },
          "failureReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "paidAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "refundedAt": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "accountId",
          "rangeId",
          "kind",
          "status",
          "totalCents",
          "currency",
          "lines",
          "paymentProvider",
          "failureReason",
          "createdAt",
          "paidAt",
          "refundedAt"
        ]
      },
      "BookingRequest": {
        "type": "object",
        "properties": {
          "bayId": {
            "type": "string",
            "format": "uuid"
          },
          "startsAt": {
            "type": "string",
            "format": "date-time",
            "example": "2026-11-24T05:00:00.000Z"
          },
          "hours": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "default": 1
          },
          "addOns": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/AddOnRequest"
            },
            "maxItems": 3,
            "default": []
          },
          "paymentMethod": {
            "type": "string",
            "minLength": 1,
            "description": "Needed unless the total is zero",
            "example": "pm_fake_ok"
          }
        },
        "required": [
          "bayId",
          "startsAt"
        ]
      },
      "AddOnRequest": {
        "type": "object",
        "properties": {
          "kind": {
            "$ref": "#/components/schemas/AddOnKind"
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 4,
            "description": "Sets of clubs; 1 for a robot or a lesson. Defaults to 1."
          }
        },
        "required": [
          "kind"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "Meta"
        ],
        "summary": "Is the API up?",
        "responses": {
          "200": {
            "description": "The API and its database answer",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            }
          }
        }
      }
    },
    "/ranges": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "List RangeOps ranges",
        "responses": {
          "200": {
            "description": "Every range",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ranges": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/RangeSummary"
                      }
                    }
                  },
                  "required": [
                    "ranges"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/ranges/{rangeId}": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "A range: bays, hours, prices and products",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Range id, or its slug",
              "example": "demo"
            },
            "required": true,
            "description": "Range id, or its slug",
            "name": "rangeId",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "The range",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Range"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/ranges/{rangeId}/availability": {
      "get": {
        "tags": [
          "Ranges"
        ],
        "summary": "Free bays and robots, hour by hour, on one local date",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "description": "Range id, or its slug",
              "example": "demo"
            },
            "required": true,
            "description": "Range id, or its slug",
            "name": "rangeId",
            "in": "path"
          },
          {
            "schema": {
              "type": "string",
              "description": "YYYY-MM-DD in the range's time zone; today if left out",
              "example": "2026-11-24"
            },
            "required": false,
            "description": "YYYY-MM-DD in the range's time zone; today if left out",
            "name": "date",
            "in": "query"
          }
        ],
        "responses": {
          "200": {
            "description": "Every open hour of every active bay",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Availability"
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/email-link": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Email a sign-in link",
        "description": "Locally the link is written to the server log instead of being emailed. Always 202, whether or not the email has an account.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "email": {
                    "type": "string"
                  }
                },
                "required": [
                  "email"
                ]
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "A link is on its way",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "sent": {
                      "type": "boolean",
                      "enum": [
                        true
                      ]
                    }
                  },
                  "required": [
                    "sent"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "The request did not match the schema",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
    "/auth/verify": {
      "post": {
        "tags": [
          "Accounts"
        ],
        "summary": "Sign in with the token from a link",
        "description": "Creates the account on first sign-in. One account works at every RangeOps range.",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "token": {
                    "type": "string",
